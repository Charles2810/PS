{
  "version": 2,
  "functions": {
    "api/*.ts": {
      "runtime": "nodejs20.x",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/prospectar", "dest": "/api/prospectar.ts" },
    { "src": "/api/health", "dest": "/api/health.ts" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}