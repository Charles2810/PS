# ============================================
# Sistema de Prospección de Clientes — Variables de Entorno
# Copia este archivo a .env y completa los valores
# ============================================

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Anon key pública (dashboards) o service_role (solo backend/producción)
SUPABASE_KEY=eyJ...

# --- Google Places API ---
# Crear en: https://console.cloud.google.com/ > APIs > Places API (nueva)
GOOGLE_PLACES_API_KEY=AIza...

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Seguridad ---
# Origen permitido para CORS. "*" para permitir todos (solo desarrollo)
CORS_ORIGIN=*

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
LOG_LEVEL=debug