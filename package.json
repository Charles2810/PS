{
  "name": "sistema-prospeccion-clientes",
  "version": "1.0.0",
  "description": "Sistema Automatizado de Prospección de Clientes - búsqueda de negocios via Google Places y diagnóstico de oportunidades en Supabase",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint --ext .ts src api",
    "test": "jest"
  },
  "keywords": [
    "prospeccion",
    "clientes",
    "google-places",
    "supabase",
    "typescript",
    "serverless"
  ],
  "author": "Charles",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}